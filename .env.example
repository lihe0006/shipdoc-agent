# Copy to .env.local for local runs. On a host (Render, Railway) set these as environment variables instead.

# Anthropic API key — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Shared access password for the hosted demo. Leave empty locally to turn the login off.
APP_PASSWORD=

# Any long random string; signs the login cookie. Changing it signs everyone out.
AUTH_SECRET=

# Optional model override (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
